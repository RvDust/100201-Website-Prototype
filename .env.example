# ==============================================================================
# 100201 FOOTBALL SHOP - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# 1. Server & Application Environment
NODE_ENV=development
PORT=4173
APP_NAME="100201 Football Shop"
APP_URL=http://localhost:4173
API_BASE_URL=http://localhost:4173/api

# 2. Merchant & Admin Access Credentials
MERCHANT_ADMIN_EMAIL=admin@100201footballshop.ph
MERCHANT_ADMIN_USERNAME=admin
MERCHANT_DEFAULT_PASSWORD=your_secure_merchant_password
MERCHANT_SALT=your_random_salt_string
MERCHANT_PASSWORD_HASH=your_sha256_hash_value
MERCHANT_MAX_FAILED_ATTEMPTS=5
MERCHANT_LOCKOUT_MS=60000
MERCHANT_SESSION_EXPIRY_MS=28800000

# 3. Relational Database Credentials (MySQL / MariaDB / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=100201_football_shop
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# 4. Payment Gateway Accounts (Philippines)
PAYMENT_GCASH_ACCOUNT_NAME="100201 Football Shop"
PAYMENT_GCASH_NUMBER=0917-000-0000
PAYMENT_MAYA_ACCOUNT_NAME="100201 Football Shop"
PAYMENT_MAYA_NUMBER=0917-000-0000
PAYMENT_BDO_ACCOUNT_NAME="100201 Sports Merch"
PAYMENT_BDO_ACCOUNT_NUMBER=0000-0000-0000
PICKUP_HUB_NAME="100201 Pasig Hub Collection Desk"
PICKUP_LOCATION="Pasig City, Metro Manila, Philippines"

# 5. Store Identity & Social Links
SHOP_SLOGAN="On and off the pitch"
SHOP_HANDLE="@100201footballshop_"
SHOP_FACEBOOK_PAGE="https://www.facebook.com/justthriftphl"
SHOP_FACEBOOK_ALBUM="https://www.facebook.com/media/set/?vanity=justthriftphl&set=a.122327598608226150"
SHOP_INSTAGRAM="https://www.instagram.com/100201footballshop_"
SHOP_TIKTOK="https://www.tiktok.com/@100201footballshop"

# 6. Promo Codes
PROMO_CODE_VIP=100201VIP
PROMO_DISCOUNT_VIP=10
PROMO_CODE_STORE15=STORE15
PROMO_DISCOUNT_STORE15=15
